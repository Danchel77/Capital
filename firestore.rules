rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Личные данные пользователя и все вложенные коллекции (Transactions, Categories, Deposits и т.д.)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Семейные группы и все связанные общие таблицы
    match /families/{familyId} {
      // Чтение документа семьи: только участники или поиск по инвайт-коду
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        (resource.data.code != null)
      );

      // Создание семьи: пользователь должен быть её владельцем
      allow create: if request.auth != null && (
        request.resource.data.ownerUid == request.auth.uid
      );

      // Обновление: существующий участник, либо новый участник, присоединяющийся по инвайт-коду
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        (request.resource.data.memberUids != null && request.auth.uid in request.resource.data.memberUids)
      );

      // Удаление семьи: только владелец
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      
      // Все вложенные финансовые коллекции семьи (Transactions, BudgetPlan, CalendarBills, Goals и т.д.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && isFamilyMember(familyId);
      }
    }

    function isFamilyMember(famId) {
      let famData = get(/databases/$(database)/documents/families/$(famId)).data;
      return famData.ownerUid == request.auth.uid ||
        (famData.memberUids != null && request.auth.uid in famData.memberUids);
    }
  }
}
