{
  "name": "capital-finance",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build:html": "node scripts/build-html.cjs",
    "build:html:check": "node scripts/build-html.cjs --check",
    "build": "node scripts/build-html.cjs && node --check server.mjs",
    "build:www": "node scripts/build-www.cjs",
    "cap:sync": "npm run build:www && npx cap sync android",
    "start": "node server.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build:html:check && npm run lint && npm run format:check",
    "update:rates": "node scripts/update-market-rates.cjs",
    "clean": "rm -rf .next dist build",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@google/genai": "^2.4.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
